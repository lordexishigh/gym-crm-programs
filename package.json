{
  "name": "alpha-crm",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Multi-tenant web CRM for Cyprus gyms — member-facing training programs.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:next": "next dev",
    "build": "next build",
    "postinstall": "node scripts/postinstall.mjs",
    "start": "node scripts/start.mjs",
    "start:next": "next start",
    "typecheck": "tsc --noEmit",
    "deploy": "node scripts/deploy.mjs",
    "smoke:portal": "node scripts/smoke-portal.mjs",
    "migrate": "node scripts/migrate.mjs",
    "seed": "node scripts/seed.mjs",
    "notify:expiry": "node scripts/notify-membership-expiry.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify:live": "playwright test --config playwright.live.config.ts"
  },
  "dependencies": {
    "jose": "^5.9.6",
    "next": "^15.5.21",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "stripe": "^22.3.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^20.17.12",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.12.1",
    "dotenv": "^16.4.7",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.10"
    },
    "sharp": "^0.35.3"
  },
  "engines": {
    "node": ">=20"
  }
}
