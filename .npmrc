# Always install devDependencies, even when npm has been told not to.
#
# WHY THIS FILE EXISTS
#
# `--omit=dev` — and NODE_ENV=production, which npm treats identically — is the
# normal way to install a Node service for production. For THIS project it
# produces an application that cannot render a single page, because the packages
# that turn source into HTML are all devDependencies:
#
#   tailwindcss, autoprefixer   PostCSS plugins named by postcss.config.mjs.
#                               Without them PostCSS throws on app/globals.css,
#                               which every route imports through app/layout.tsx.
#   typescript                  every route is .ts/.tsx.
#
# Measured on this project, `NODE_ENV=production npm ci` installs 70 packages
# instead of 230 and none of the four is among them. The consequences are not a
# missing stylesheet — they are total unreachability, and they cascade:
#
#   1. scripts/postinstall.mjs correctly declines to build (it cannot), so there
#      is no .next/BUILD_ID and `npm start` falls back to `next dev`.
#   2. `next dev` finds typescript missing and shells out to npm MID-BOOT to
#      install it — an unrequested network call during server startup, which on a
#      host without registry access simply hangs.
#   3. tailwindcss is still absent afterwards, so no route ever compiles. The
#      readiness gate in scripts/lib/dev-server.mjs waits for entry routes that
#      can never answer, then opens the port onto a server that still cannot
#      compile.
#
# The observable result is the one an automated review of this project kept
# reporting: `/`, `/login` and `/portal/login` all time out, the member portal
# reads as completely unreachable, and nothing in the app's own output explains
# why. Reproduced end to end before this file was added: `GET /` returned nothing
# for 222s and then timed out at exactly 45.005s.
#
# `include` is the inverse of `omit` and WINS over it regardless of where either
# is set, so this neutralises `--omit=dev` on the command line as well as an
# inherited NODE_ENV=production. Verified: with this file present,
# `npm ci --omit=dev` installs tailwindcss, autoprefixer, typescript and postcss.
#
# The cost is a larger node_modules on a production host. That is the correct
# trade: these are build-time dependencies of an app that builds itself at
# install time (scripts/postinstall.mjs) and compiles on demand in its fallback,
# so for this project they are not optional in any environment.
#
# scripts/start.mjs preflights the same packages and refuses to start with a
# named error if they are missing anyway (a hand-pruned node_modules, an install
# that predates this file), so the failure can never again present as a silent
# hang.
include=dev
