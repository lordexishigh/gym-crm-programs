# Alpha CRM — environment variables.
# Copy to `.env` for local development. NEVER commit real secrets (.env is
# gitignored). In production these are set in the hosting provider's
# environment/secret store (Vercel + Supabase), not in source.

# --- Database (Supabase Postgres, EU region) -------------------------------
# Privileged connection used for migrations and as the base connection the app
# drops from into the unprivileged `app_user` role per request.
# Local example: postgres://postgres:postgres@localhost:5432/alpha_crm
DATABASE_URL=

# Connection used ONLY to run migrations (scripts/migrate.mjs + auto-migrate on
# boot). Migrations run DDL (CREATE/ALTER/GRANT ROLE) which Supabase's TRANSACTION
# pooler (port 6543) rejects with a FATAL XX000. Point this at the SESSION pooler
# (port 5432) or the DIRECT connection so role grants like 0005 apply cleanly.
# Falls back to DATABASE_URL if unset.
MIGRATE_DATABASE_URL=

# --- Supabase Auth (asymmetric JWT, verified via JWKS) ---------------------
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Safe for the browser / public auth calls.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (sb_secret_...) for admin/provisioning paths. NEVER expose.
SUPABASE_SECRET_KEY=
# NOTE: no JWT secret needed — access tokens are verified against the project's
# published JWKS at ${NEXT_PUBLIC_SUPABASE_URL}/auth/v1/.well-known/jwks.json.
# Ensure the project's Auth signing key is an asymmetric key (ECC/ES256), not the
# legacy HS256 shared secret (Dashboard → Project Settings → JWT Keys).

# --- Transactional email (Resend, EU sending) ------------------------------
# Server-only API key (use a Resend sandbox/test key in development).
RESEND_API_KEY=
# Verified sender. The domain part MUST be a Resend *verified sending domain*
# with SPF + DKIM DNS records published (see docs/DEPLOYMENT.md) — sending from
# the generic onboarding@resend.dev address fails DKIM and harms deliverability.
# e.g. "Alpha CRM <noreply@mail.yourgym.example>".
INVITE_FROM_EMAIL=
# Signing secret for the inbound Resend webhook (app/api/email/webhook), used to
# verify bounce/complaint events are genuinely from Resend (Svix signature).
# Copy it from the webhook's settings in the Resend dashboard (format whsec_...).
RESEND_WEBHOOK_SECRET=

# --- Observability / alerting (beta-hardening-001) -------------------------
# Optional generic JSON webhooks. MONITORING_WEBHOOK_URL receives every captured
# exception; ALERT_WEBHOOK_URL (falls back to the monitoring URL) receives only
# `critical` events (e.g. an invite send failure). Leave unset to log-only.
MONITORING_WEBHOOK_URL=
ALERT_WEBHOOK_URL=

# --- App -------------------------------------------------------------------
# Absolute base URL used to build invite/onboarding links in emails.
# Local example: http://localhost:3000 ; production: https://app.yourdomain.eu
APP_BASE_URL=http://localhost:3000

# --- GDPR data retention (beta-gdpr-002) -----------------------------------
# Platform-wide retention window, in days, after which an inactive data subject
# becomes eligible for erasure/anonymisation. A gym can override this per-tenant
# via gym.data_retention_days. If unset/invalid, the built-in default applies
# (1095 days = 3 years). See docs/DATA_RETENTION.md for the full behaviour.
DATA_RETENTION_DAYS=1095
