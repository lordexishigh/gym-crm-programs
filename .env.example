# Alpha CRM — environment variables.
# Copy to `.env` for local development. NEVER commit real secrets (.env is
# gitignored). In production these are set in the hosting provider's
# environment/secret store (Vercel + Supabase), not in source.

# --- Database (Supabase Postgres, EU region) -------------------------------
# Privileged connection used for migrations and as the base connection the app
# drops from into the unprivileged `app_user` role per request.
# Local example: postgres://postgres:postgres@localhost:5432/alpha_crm
DATABASE_URL=

# Connection used ONLY to run migrations (scripts/migrate.mjs + auto-migrate on
# boot). Migrations run DDL (CREATE/ALTER/GRANT ROLE) which Supabase's TRANSACTION
# pooler (port 6543) rejects with a FATAL XX000. Point this at the SESSION pooler
# (port 5432) or the DIRECT connection so role grants like 0005 apply cleanly.
# Falls back to DATABASE_URL if unset.
MIGRATE_DATABASE_URL=

# --- Database timeouts (all optional, milliseconds) -------------------------
# Bounded waits so an UNREACHABLE database fails fast instead of hanging. Without
# a connect bound, `pg` inherits the OS TCP timeout (~21s Windows, up to ~130s
# Linux) and every DB-backed route sits silent for that long: the user sees a
# blank tab, no error boundary renders (nothing threw yet), and readiness probes
# exceed their own budget — the app looks CRASHED rather than degraded.
# Raise these only if the database is genuinely far away (a cold serverless
# region); the defaults suit an app deployed next to its database.
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=15000
DB_QUERY_TIMEOUT_MS=15000
# Independent ceiling for the /api/health DB ping. Must stay well under whatever
# your monitor / deploy gate / CI readiness loop is willing to wait.
HEALTH_DB_TIMEOUT_MS=3000

# --- Supabase Auth (asymmetric JWT, verified via JWKS) ---------------------
# Bounded wait for calls to the auth service, milliseconds (optional).
# `fetch` does not time out on its own, so an auth endpoint that accepts the
# connection then goes silent would hang the /login Server Action ("Signing in…"
# forever) and, via the middleware token refresh, every /dashboard and /portal
# request — before any error boundary can render. Raise only for a genuinely
# distant auth region.
AUTH_FETCH_TIMEOUT_MS=8000
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Safe for the browser / public auth calls.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (sb_secret_...) for admin/provisioning paths. NEVER expose.
SUPABASE_SECRET_KEY=
# NOTE: no JWT secret needed — access tokens are verified against the project's
# published JWKS at ${NEXT_PUBLIC_SUPABASE_URL}/auth/v1/.well-known/jwks.json.
# Ensure the project's Auth signing key is an asymmetric key (ECC/ES256), not the
# legacy HS256 shared secret (Dashboard → Project Settings → JWT Keys).

# --- Transactional email (Resend, EU sending) ------------------------------
# Server-only API key (use a Resend sandbox/test key in development).
RESEND_API_KEY=
# Verified sender. The domain part MUST be a Resend *verified sending domain*
# with SPF + DKIM DNS records published (see docs/DEPLOYMENT.md) — sending from
# the generic onboarding@resend.dev address fails DKIM and harms deliverability.
# e.g. "Alpha CRM <noreply@mail.yourgym.example>".
INVITE_FROM_EMAIL=
# Signing secret for the inbound Resend webhook (app/api/email/webhook), used to
# verify bounce/complaint events are genuinely from Resend (Svix signature).
# Copy it from the webhook's settings in the Resend dashboard (format whsec_...).
RESEND_WEBHOOK_SECRET=

# --- Payments (Stripe) ------------------------------------------------------
# Server-only secret key (use a Stripe TEST key in development).
STRIPE_SECRET_KEY=
# Signing secret for the Stripe webhook (app/api/stripe/webhook), used to
# verify billing events are genuinely from Stripe. Copy it from the webhook's
# settings in the Stripe Dashboard (format whsec_...). Register the endpoint
# for: checkout.session.completed, invoice.payment_failed,
# invoice.payment_succeeded, customer.subscription.deleted.
# NOTE: automated failed-payment RETRIES are Stripe's own Smart Retries —
# enable them in the Stripe Dashboard under Billing → Revenue recovery. This
# app tracks the retry count/status and notifies the member on each failure.
STRIPE_WEBHOOK_SECRET=

# --- Observability / alerting (beta-hardening-001) -------------------------
# Optional generic JSON webhooks. MONITORING_WEBHOOK_URL receives every captured
# exception; ALERT_WEBHOOK_URL (falls back to the monitoring URL) receives only
# `critical` events (e.g. an invite send failure). Leave unset to log-only.
MONITORING_WEBHOOK_URL=
ALERT_WEBHOOK_URL=

# --- Startup (scripts/start.mjs, used by `npm start`) -----------------------
# `.next/` is gitignored, so a fresh clone that runs `npm start` without
# `npm run build` has nothing to serve: `next start` exits and the port is never
# bound. A client behind a forwarded port/proxy experiences that as a NAVIGATION
# HANG rather than a connection error, so every route appears to time out and the
# whole product reads as unreachable.
# Autobuilding a missing build is therefore the DEFAULT — refusing to serve looks
# identical to hanging from any client's point of view. Concurrent builds are made
# safe with a lock (outside `.next`, which `next build` deletes) that elects one
# builder while other starts wait for its output.
# Set to 0 to restore the old fail-fast — for callers that manage their own builds
# and would rather hear about a missing one than wait for it.
# START_AUTOBUILD=0
# Ceiling (ms) on waiting for ANOTHER process's build before giving up (default
# 600000). Finite on purpose: an unbounded wait is the hang this wrapper removes.
# START_BUILD_WAIT_MS=600000

# Hard ceiling (ms) for each boot-time script the Next instrumentation hook
# spawns (scripts/migrate.mjs, then scripts/seed-catalog.mjs). These talk to a
# REMOTE database; without a bound, a stalled connection leaves the child alive
# forever and every restart leaks another one, each holding a pooler slot. A
# killed run is retried on the next boot (both scripts are idempotent).
BOOT_SCRIPT_TIMEOUT_MS=120000

# --- App -------------------------------------------------------------------
# Absolute base URL used to build invite/onboarding links in emails.
# Local example: http://localhost:3000 ; production: https://app.yourdomain.eu
APP_BASE_URL=http://localhost:3000

# --- Seed / demo bootstrap (scripts/seed.mjs) ------------------------------
# `npm run seed` creates the FIRST gym + owner account (the app has no public
# signup, so there is otherwise no way in), and by default a demo trainer, a
# demo member with an assigned program, and the three plan tiers — so a new
# evaluator can walk the whole trainer→member flow with no manual setup.
# All optional; the defaults below are what the script uses.
SEED_GYM_NAME=Demo Gym
SEED_GYM_SLUG=demo-gym
SEED_ADMIN_EMAIL=owner@demo.local
SEED_ADMIN_PASSWORD=DemoOwner!2026
SEED_ADMIN_NAME=Demo Owner
SEED_TRAINER_EMAIL=trainer@demo.local
SEED_TRAINER_PASSWORD=DemoTrainer!2026
SEED_MEMBER_EMAIL=member@demo.local
SEED_MEMBER_PASSWORD=DemoMember!2026
# Set to 0 when bootstrapping a REAL gym — fake members and subscriptions in a
# live roster are actively unwanted. The gym + owner are still created.
SEED_DEMO_DATA=1

# --- GDPR data retention (beta-gdpr-002) -----------------------------------
# Platform-wide retention window, in days, after which an inactive data subject
# becomes eligible for erasure/anonymisation. A gym can override this per-tenant
# via gym.data_retention_days. If unset/invalid, the built-in default applies
# (1095 days = 3 years). See docs/DATA_RETENTION.md for the full behaviour.
DATA_RETENTION_DAYS=1095
